PORT=5000
MAPTILER_API_KEY=your_maptiler_api_key_here

# Phải trùng với VITE_GOOGLE_CLIENT_ID để backend xác thực Google ID token
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# SMTP để gửi email mã xác nhận đặt lại mật khẩu (OTP)
# Ví dụ với Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# và SMTP_PASS là "App Password" (https://myaccount.google.com/apppasswords)
# Nếu bỏ trống, server chạy chế độ DEV: mã OTP được in ra console thay vì gửi email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KindnessMap <no-reply@kindnessmap.vn>"

# Gemini API key cho chatbot AI
GEMINI_API_KEY=your_gemini_api_key_here
# Nên dùng model nhẹ/mới trước để giảm quota/cost và tránh quá tải
GEMINI_MODEL=gemini-2.5-flash-lite

# Tuỳ chọn: provider dự phòng nếu Gemini hết quota/quá tải
# Tạo miễn phí tại https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Tuỳ chọn: provider dự phòng khác nếu Gemini/Groq lỗi
# Tạo tại https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Facebook OAuth - tạo App tại https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
